/* Selector de fondos (scripts/rofi-wallpaper): rejilla de miniaturas con el mismo aspecto que
   el lanzador (rofi/config.rasi): negro translúcido, bordes redondeados, Maple Mono y el
   dorado #a8964f en lo seleccionado. */
* {
    font: "Maple Mono NF 10";
    background-color: transparent;
    text-color: #606060;
    accent: #a8964f;
}

configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
}

window {
    location: center;
    anchor: center;
    width: 1160px;
    border: 2px;
    border-color: #000000;
    border-radius: 20px;
    padding: 20px;
    background-color: rgba(0,0,0,0.7);
}

mainbox {
    children: [inputbar, listview];
    spacing: 16px;
}

inputbar {
    children: [prompt, entry];
    spacing: 10px;
    padding: 4px 8px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Buscar fondo";
    placeholder-color: #444444;
    text-color: #ffffff;
}

listview {
    columns: 4;
    lines: 3;
    spacing: 12px;
    dynamic: false;
    scrollbar: false;
    fixed-height: true;
    flow: horizontal;
}

element {
    orientation: vertical;
    padding: 8px;
    spacing: 6px;
    border: 2px;
    border-radius: 12px;
    border-color: transparent;
}

element selected.normal {
    border-color: @accent;
    background-color: rgba(168,150,79,0.12);
    text-color: @accent;
}

element-icon {
    size: 240px;
    horizontal-align: 0.5;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
