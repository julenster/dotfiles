/* Selector de fondos (scripts/rofi-wallpaper): rejilla de miniaturas con el mismo aspecto que
   el lanzador (rofi/config.rasi): negro translúcido, bordes redondeados, Maple Mono y el
   dorado #a8964f en lo seleccionado. La rejilla copia la de Artur (3x3, solo miniaturas, sin
   paginar: baja fila a fila) pero con casillas 16:9 en vez de cuadradas. */
* {
    font: "Maple Mono NF 10";
    background-color: transparent;
    text-color: #606060;
    accent: #a8964f;
}

configuration {
    show-icons: true;
    scroll-method: 1;
    icon-theme: "Papirus-Dark";
}

window {
    location: center;
    anchor: center;
    width: 1040px;
    border: 2px;
    border-color: #000000;
    border-radius: 20px;
    padding: 20px;
    background-color: rgba(0,0,0,0.7);
}

mainbox {
    children: [inputbar, listview];
    spacing: 16px;
}

inputbar {
    children: [prompt, entry];
    spacing: 10px;
    padding: 4px 8px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Buscar fondo";
    placeholder-color: #444444;
    text-color: #ffffff;
}

listview {
    columns: 3;
    lines: 3;
    spacing: 10px;
    dynamic: false;
    scrollbar: false;
    fixed-height: true;
    flow: horizontal;
}

/* Casilla 16:9. rofi reserva siempre una caja de size x size para el icono (y carga la imagen a
   ese tamaño, por eso no se puede bajar size sin que se vea borrosa). Así que size es el ANCHO
   (1000px útiles / 3 columnas - huecos - 8px de marco ≈ 318px) y el padding negativo del element
   le quita el alto sobrante: 318x179 de imagen + 4px de marco. Las miniaturas que genera el
   script ya son 16:9 (también la de buscar en Wallhaven y la de más resultados). */
element {
    children: [element-icon];
    padding: -66px 4px -65px 4px;
    border-radius: 10px;
}

element normal.normal, element alternate.normal,
element normal.active, element alternate.active,
element normal.urgent, element alternate.urgent {
    background-color: transparent;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @accent;
}

element-icon {
    size: 318px;
    cursor: inherit;
}
