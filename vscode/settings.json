{
    // ── Aspecto: el de ranger097/ranger097_nixos_dotfiles ──────────────
    // Tema Aldrico's Gruvbox ("Gruvbox in Black") + Maple Mono NF, sin pestañas,
    // sin barra de estado, barra de actividad a la derecha y mucho interlineado.
    "workbench.colorTheme": "Gruvbox in Black",
    "workbench.iconTheme": "catppuccin-mocha",
    "workbench.startupEditor": "none",
    "workbench.editor.showTabs": "none",
    "workbench.statusBar.visible": false,
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "default",
    "workbench.layoutControl.enabled": false,
    "workbench.tree.indent": 14,
    "window.titleBarStyle": "custom",
    "window.commandCenter": false,
    "window.menuBarVisibility": "toggle",
    "breadcrumbs.enabled": false,

    // ── Editor ─────────────────────────────────────────────────────────
    "editor.fontFamily": "'Maple Mono NF', monospace",
    "editor.fontSize": 14,
    "editor.lineHeight": 2.1,
    "editor.fontLigatures": true,
    "editor.minimap.enabled": false,
    "editor.glyphMargin": false,
    "editor.folding": false,
    "editor.lineNumbers": "on",
    "editor.renderLineHighlight": "line",
    "editor.guides.indentation": false,
    "editor.padding.top": 20,
    "editor.scrollbar.verticalScrollbarSize": 10,
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.stickyScroll.enabled": false,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.formatOnSave": true,
    "workbench.list.smoothScrolling": true,
    "files.autoSave": "afterDelay",

    // ── Terminal integrada ─────────────────────────────────────────────
    "terminal.integrated.fontFamily": "'Maple Mono NF'",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.smoothScrolling": true,

    // ── Java ───────────────────────────────────────────────────────────
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.import.gradle.wrapper.enabled": true,
    "java.inlayHints.parameterNames.enabled": "literals",
    "java.saveActions.organizeImports": true,
    "java.configuration.runtimes": [
        { "name": "JavaSE-25", "path": "/usr/lib/jvm/java-25-openjdk", "default": true }
    ],
    "errorLens.enabledDiagnosticLevels": ["error", "warning"],
    "errorLens.fontStyleItalic": true,

    // ── Varios ─────────────────────────────────────────────────────────
    "telemetry.telemetryLevel": "off",
    "claudeCode.preferredLocation": "panel",
    "security.workspace.trust.untrustedFiles": "open"
}
