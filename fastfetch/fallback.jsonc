// Se usa cuando no está ~/Pictures/miku/terminal.png o la terminal no admite imágenes
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "builtin", "color": { "1": "38;2;57;197;187", "2": "38;2;225;40;133" } },
    "display": { "separator": "  ", "color": { "keys": "38;2;57;197;187", "title": "38;2;225;40;133" } },
    "modules": ["title", "separator", "os", "kernel", "de", "shell", "terminal", "packages", "cpu", "gpu", "memory", "uptime", "break", "colors"]
}
